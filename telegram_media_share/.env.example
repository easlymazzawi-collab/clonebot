# ─── Telegram User Account (for Cloner) ───────────────────────────────────────
API_ID=28030819
API_HASH=your_api_hash_here
PHONE=+84xxxxxxxxx

# ─── Bot (for Share Links) ─────────────────────────────────────────────────────
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BOT_USERNAME=your_bot_username          # Without @

# ─── Storage Channel ──────────────────────────────────────────────────────────
# Private channel where the bot is admin — all media is stored here
# Format: -100xxxxxxxxxx  (get from @userinfobot or API)
STORAGE_CHANNEL=-1001234567890

# ─── Admins ────────────────────────────────────────────────────────────────────
# Comma-separated list of Telegram user IDs
ADMIN_IDS=123456789,987654321

# ─── Database ──────────────────────────────────────────────────────────────────
DB_PATH=media_share.db

# ─── Cloner Defaults (optional – can be set interactively) ───────────────────
# SOURCE_FORUM=-1001234567890
# DEST_FORUM=-1009876543210
